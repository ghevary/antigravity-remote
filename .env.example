# ==============================================================================
# Antigravity Telegram Bridge Configuration
# ==============================================================================

# 1. Telegram Bot Token from @BotFather
TELEGRAM_BOT_TOKEN="YOUR_TELEGRAM_BOT_TOKEN_HERE"

# 2. Whitelisted Telegram User IDs (Pisahkan dengan koma jika lebih dari satu)
# Dapatkan ID Telegram Anda dari @userinfobot di Telegram
ALLOWED_USER_IDS="123456789"

# 3. Path Direktori Kerja Default (Workspace awal)
DEFAULT_WORKING_DIR="/home/ghenom"

# 4. Path ke Binary Antigravity CLI
AGY_BIN_PATH="/home/ghenom/.local/bin/agy"

# 5. Reasoning Effort (low | medium | high)
AGY_EFFORT="high"
